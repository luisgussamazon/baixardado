{
  "name": "a3x-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "knowledge:validate": "node scripts/import-knowledge.mjs",
    "knowledge:import": "node scripts/import-knowledge.mjs",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "research:study": "tsx scripts/research-study.ts",
    "research:plan": "tsx scripts/research-plan.ts",
    "research:branch": "tsx scripts/research-branch.ts",
    "model:connect": "tsx scripts/model-worker.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
