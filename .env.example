# URL do banco PostgreSQL, fornecida pelo Railway ou pelo seu PostgreSQL local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a3x_ai
# Chave forte (mín. 24 caracteres); usada SOMENTE antes da criação da primeira conta.
BOOTSTRAP_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES
# Crie sua chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque_a_chave_aqui
# Modelo padrão; altere conforme disponibilidade e orçamento da sua conta de API.
AI_MODEL=gpt-5.4-mini
# Limites de segurança e custos.
DAILY_MESSAGE_LIMIT=50
# Nome mostrado na interface.
NEXT_PUBLIC_APP_NAME=A3X AI
