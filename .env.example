# URL do banco PostgreSQL, fornecida pelo Railway ou pelo seu PostgreSQL local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a3x_ai
# Chave forte (mín. 24 caracteres); usada SOMENTE antes da criação da primeira conta.
BOOTSTRAP_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES
# Limites de segurança e custos.
DAILY_PROJECT_LIMIT=50
# Estudos públicos fixos: 0 desativa. Não utiliza histórico privado.
A3X_AUTO_STUDY=1
# Ponte do computador: 0 desativa globalmente. Cada conta precisa autorizar seu computador.
LOCAL_MODEL_BRIDGE=1
# Opcional: cadastrar OPENAI_API_KEY somente no cofre de variáveis do Railway.
# A presença da chave não ativa a nuvem sem consentimento por conta.
OPENAI_ENABLED=1
OPENAI_MONTHLY_BUDGET_USD=5
# Nome mostrado na interface.
NEXT_PUBLIC_APP_NAME=A3X AI
